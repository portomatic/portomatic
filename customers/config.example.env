# The project must be directly owned by this Portomatic Google Cloud organization.
PORTOMATIC_GCP_ORGANIZATION_ID=
PORTOMATIC_GCP_PROJECT_ID=

# Bucket names are globally unique. us-west1 keeps data in the western US.
PORTOMATIC_GCS_BUCKET=
PORTOMATIC_GCS_LOCATION=us-west1

# Comma-separated IAM principals, for example:
# user:founder-one@portomatic.com,user:founder-two@portomatic.com
PORTOMATIC_GCP_FOUNDER_PRINCIPALS=

# Optional founder-controlled operational identities that inherit project access.
# Keep this explicit; the privacy verifier rejects undeclared project data admins.
PORTOMATIC_GCP_TRUSTED_OPERATOR_PRINCIPALS=

# Normally derived from the project ID; override only when reusing existing accounts.
PORTOMATIC_GCS_UPLOADER_SERVICE_ACCOUNT=
PORTOMATIC_GCS_SIGNER_SERVICE_ACCOUNT=

# Short-lived signed URLs used by the local viewer.
PORTOMATIC_GCS_SIGNED_URL_DURATION=15m

# Private Cloud SQL PostgreSQL index. Recordings remain the source of truth in GCS.
PORTOMATIC_CLOUD_SQL_INSTANCE=portomatic-calls
PORTOMATIC_CLOUD_SQL_DATABASE=portomatic_calls
# Optional override; normally derived from project and location.
PORTOMATIC_CLOUD_SQL_BOOTSTRAP_SECRET_VERSION=

# Stored with each replaceable derived transcript run.
PORTOMATIC_TRANSCRIPT_MODEL=mlx-community/whisper-large-v3-turbo
