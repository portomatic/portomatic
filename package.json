{
  "name": "portomatic",
  "private": true,
  "type": "module",
  "scripts": {
    "crm:start": "node apps/crm/server.mjs",
    "crm:install": "bash apps/crm/ops/install.sh",
    "crm": "node apps/crm/cli.mjs",
    "crm:sync": "node apps/crm/cli.mjs sync",
    "landing:capture": "node apps/landing/scripts/capture-references.mjs",
    "landing:dev": "pnpm --dir apps/landing dev",
    "landing:build": "pnpm --dir apps/landing build",
    "landing:storyboard": "node apps/landing/dev-server.mjs",
    "customers:provision": "bash customers/scripts/provision-gcs.sh",
    "customers:provision-db": "bash customers/scripts/provision-cloud-sql.sh",
    "customers:migrate-db": "node customers/scripts/apply-migrations.mjs",
    "customers:verify-storage": "bash customers/scripts/verify-private-gcs.sh",
    "customers:verify-db": "node customers/scripts/verify-database.mjs",
    "customers:upload": "node customers/scripts/upload-recording.mjs",
    "customers:upload-source": "node customers/scripts/upload-source-recording.mjs",
    "customers:import-transcript": "node customers/scripts/import-transcript.mjs",
    "customers:slice-transcript": "node customers/scripts/slice-transcript.mjs",
    "customers:list": "node customers/scripts/list-calls.mjs",
    "customers:conversations": "node customers/scripts/list-conversations.mjs",
    "customers:search": "node customers/scripts/search-transcripts.mjs",
    "customers:export": "node customers/scripts/export-call.mjs",
    "customers:url": "node customers/scripts/generate-url.mjs",
    "customers:open": "node customers/scripts/open-call.mjs",
    "test": "node --test"
  }
}
